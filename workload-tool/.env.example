# Workload Allocation Tool — local development
# Copy to .env (git-ignored) and adjust. Nothing here reaches the internet.

# --- Database -----------------------------------------------------------------
# Local dev SQL Server. `encrypt=true;trustServerCertificate=true` is what a
# dev/self-signed cert needs; production uses a proper internal CA and should
# drop trustServerCertificate.
DATABASE_URL="sqlserver://localhost:1433;database=workload_allocation;user=sa;password=Dev_Passw0rd!;encrypt=true;trustServerCertificate=true"

# --- Postgres / Supabase target (optional) --------------------------------------
# SQL Server is the production target. Postgres is a SECOND target for a hosted
# demo, and it SHARES a database with an unrelated storefront application.
#
# This app owns exactly one schema: "workload". The storefront owns "public".
# Everything Prisma does here is scoped to "workload" (see
# prisma/postgres/schema.prisma), which is what makes sharing safe.
#
# IMPORTANT: use the SESSION-mode (direct, :5432) connection string, NOT the
# transaction-mode pooler (:6543). This app relies on interactive transactions
# for ticket+audit atomicity, and those do not work through a transaction-mode
# pooler.
#
# The ?schema=workload parameter keeps Prisma's _prisma_migrations ledger inside
# our schema instead of polluting the storefront's public schema.
#
# DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?schema=workload&sslmode=require"
# DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?schema=workload&sslmode=require"

# --- Auth ---------------------------------------------------------------------
# iis   -> Windows Integrated Auth; identity comes from the IIS/iisnode headers.
# entra -> Entra ID; identity comes from the injected client principal header.
# dev   -> fake local identity, no AD needed. LOCAL ONLY.
AUTH_MODE=dev

# dev mode: the identity every request runs as. The header identity switcher in
# the UI overrides this per browser (cookie) so you can click through all four
# roles without restarting.
DEV_UPN=admin@contoso.local
DEV_DISPLAY_NAME="Dev Admin"
# Leave DEV_GROUPS empty to take the role from the seeded Agent row, which is
# what you want for clicking through. Set it (e.g. "WAT-Admins") only to test
# the AD-group -> role mapping itself: groups WIN over the Agent row, so a
# stale value here makes every dev identity resolve to that role no matter who
# DEV_UPN points at.
DEV_GROUPS=

# AD group -> application role. Evaluated most-privileged-first. Same mapping is
# used by iis and entra modes; dev mode uses it too so the modes behave alike.
AD_GROUP_ADMIN=WAT-Admins
AD_GROUP_MANAGER=WAT-Managers
AD_GROUP_LEADER=WAT-Leaders
AD_GROUP_MEMBER=WAT-Members

# --- Allocation worker --------------------------------------------------------
# One-line switches into the allocation engine. Defaults match the agreed rules.
ALLOCATION_ORDERING=priorityBandedFifo
ALLOCATION_POLICY=leastLoaded
WORKER_INTERVAL_MS=15000

# --- Mail ingestion -----------------------------------------------------------
# Only `stub` is implemented. exchange/graph/imap are deliberately unbuilt until
# the platform decision is made.
MAIL_ADAPTER=stub

# --- SLA clock ----------------------------------------------------------------
# Business-hours window used by the (stubbed) business-hours calendar.
BUSINESS_DAY_START=09:00
BUSINESS_DAY_END=17:00
BUSINESS_DAYS=1,2,3,4,5
