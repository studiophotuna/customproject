# Copy to .env.local and fill in. Values marked "public" are safe to expose.

# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Supabase service role — SERVER ONLY, never expose to the browser.
# Project Settings -> API -> service_role. Used by Stripe webhooks / admin tasks.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Phase 5)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Absolute base URL of the site (used for redirects/callbacks).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
